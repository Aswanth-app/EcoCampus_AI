# EcoCampus AI - Environment Configuration
# Copy this file to .env.local for local development.
# Do NOT commit real secrets or production credentials to source control.

# Supabase Public Configuration (Browser accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Server-only Supabase Service Role Secret Key (Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hardware & Telemetry Ingestion Pre-Shared Key (Used by ESP32 devices)
DEVICE_API_KEY=your-device-api-key
